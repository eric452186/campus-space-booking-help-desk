# Copy this file to .env.local and fill in the key locally.
# Never commit .env.local or paste the key into source code or chat messages.

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Optional local paths. The app creates runtime files when needed.
CAMPUS_DB_PATH=data/campus_demo.db
CAMPUS_RULES_PATH=data/campus_rules.md
CAMPUS_RAG_CACHE_PATH=data/.rag_index.json

# Maximum number of model -> tool -> model loops for one user message.
MAX_TOOL_ROUNDS=5

# Gradio binds to localhost by default.
GRADIO_SERVER_NAME=127.0.0.1
GRADIO_SERVER_PORT=7860
